# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings → API). Solo la URL y la anon key: ambas son públicas por diseño
# y la seguridad la dan las políticas RLS.
# NUNCA pongas aquí la service_role key: va únicamente en Supabase Secrets.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
